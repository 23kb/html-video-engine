{
  "name": "html-snapshot",
  "version": "0.1.0",
  "private": true,
  "description": "Freeze any web UI into a self-contained HTML snapshot a video tool can mount in an iframe and puppet, with state fragments and QA gates.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "freeze": "node scripts/freeze.mjs",
    "ingest": "node scripts/ingest.mjs",
    "states": "node scripts/states.mjs",
    "gates": "node scripts/gates.mjs",
    "manifest": "node scripts/manifest.mjs",
    "serve": "node scripts/serve.mjs",
    "postinstall": "npx playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.50.0"
  }
}
