{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reference-motion-spec/motion-spec.v1",
  "title": "motion-spec.json v1",
  "description": "Tool-neutral motion spec of one reference video. Every seam and landing cites a sheet + tile; a row without a citation is a guess and says so via confidence:\"low\" and evidence:[].",
  "type": "object",
  "required": [
    "version",
    "meta",
    "identity",
    "structure",
    "camera",
    "seams",
    "pacing",
    "ui_motion",
    "text_motion",
    "grammar",
    "sound",
    "eases",
    "do_not",
    "evidence_rules"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "meta": {
      "type": "object",
      "required": [
        "source",
        "duration",
        "fps",
        "width",
        "height",
        "aspect",
        "audio"
      ],
      "additionalProperties": true,
      "properties": {
        "source": {
          "type": "string",
          "description": "Local file name only. Internal; never published with the spec."
        },
        "duration": {
          "type": "number"
        },
        "fps": {
          "type": "number",
          "description": "Source average fps."
        },
        "sample_fps": {
          "type": "number",
          "description": "Fps the 24 fps sheets were sampled at (24)."
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "aspect": {
          "type": "string",
          "examples": [
            "16:9",
            "9:16",
            "1:1"
          ]
        },
        "audio": {
          "type": "boolean"
        },
        "black_head": {
          "type": "number",
          "description": "Seconds of black at the start (0 if none)."
        },
        "black_tail": {
          "type": "number",
          "description": "Seconds of black at the end (0 if none). Do not replicate a black tail."
        },
        "presentation_chrome": {
          "type": "string",
          "description": "If the film sits inside a presentation frame (editor UI, phone mock, slide), say which region is the film. Do not copy the chrome."
        },
        "use_when": {
          "type": "string",
          "description": "One sentence: what this reference is good for (library.mjs carries it into catalog.json)."
        },
        "reference_brand_terms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every product, brand, mascot or slogan word visible in the reference, listed once here and nowhere else in the spec. The validator rejects any other string field that carries one of them, or any quoted on-screen copy. The spec describes motion; it never quotes the reference."
        },
        "loop": {
          "type": "string",
          "description": "For a looped / repeated film: cycle length and how many cycles the export contains (\"7.5 s cycle × 2; opens mid-sweep; ends one frame before a third join\"). Omit the key when the film does not loop; never write \"no\" or \"not a loop\" here."
        },
        "time_precision": {
          "type": "string",
          "default": "24 fps resample; every time is approximate within 1/24 s (0.0417 s). Nothing here is a recovered keyframe or a source ease."
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "palette",
        "type_roles",
        "ground",
        "host_element",
        "brand_role"
      ],
      "properties": {
        "palette": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hex",
              "role"
            ],
            "properties": {
              "hex": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "description": "Sampled with palette.mjs (dominant colours per frame) — never estimated by eye."
              },
              "role": {
                "type": "string",
                "examples": [
                  "ground",
                  "ink",
                  "accent",
                  "interstitial",
                  "ui-surface",
                  "ui-primary"
                ]
              },
              "note": {
                "type": "string"
              },
              "evidence": {
                "$ref": "#/definitions/evidence"
              }
            }
          }
        },
        "type_roles": {
          "type": "array",
          "description": "Each text role with its cap-height as a fraction of frame height (measured on a sheet tile).",
          "items": {
            "type": "object",
            "required": [
              "role",
              "size_frac"
            ],
            "properties": {
              "role": {
                "type": "string",
                "examples": [
                  "display",
                  "title",
                  "caption",
                  "ui-body",
                  "brand-mark"
                ]
              },
              "size_frac": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "weight": {
                "type": "string"
              },
              "style": {
                "type": "string",
                "examples": [
                  "sans",
                  "serif",
                  "mono",
                  "italic"
                ]
              },
              "case": {
                "type": "string",
                "examples": [
                  "sentence",
                  "title",
                  "upper"
                ]
              },
              "evidence": {
                "$ref": "#/definitions/evidence"
              }
            }
          }
        },
        "ground": {
          "type": "string",
          "description": "Background / atmosphere in words: flat, grid, gradient, haze, vignette, grain, photo."
        },
        "host_element": {
          "type": "string",
          "description": "The recurring element that threads the film (input box, card, orb, mascot). 'none' if every scene is new."
        },
        "persistent_elements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Screen-space constants that survive every seam (a brand mark top-left, a progress bar). Named once here instead of on every seam's carrier."
        },
        "brand_role": {
          "type": "string",
          "enum": [
            "accent",
            "fill",
            "absent",
            "mixed"
          ],
          "description": "Brand colour used as punctuation (accent) or as whole-frame fill."
        }
      }
    },
    "structure": {
      "type": "object",
      "required": [
        "acts",
        "scenes"
      ],
      "properties": {
        "acts": {
          "type": "array",
          "description": "Coarse story structure. Name repeats explicitly (\"cycle 2 repeats cycle 1 with new copy\").",
          "items": {
            "type": "object",
            "required": [
              "name",
              "in",
              "out"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "in": {
                "type": "number"
              },
              "out": {
                "type": "number"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "scenes": {
          "type": "array",
          "description": "One row per scene (a composition that stands between two seams).",
          "items": {
            "type": "object",
            "required": [
              "id",
              "in",
              "out",
              "subject",
              "framing_fill",
              "composition",
              "hold_carrier",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Short stable id, e.g. S1, S2."
              },
              "in": {
                "type": "number"
              },
              "out": {
                "type": "number"
              },
              "subject": {
                "type": "string",
                "description": "What fills the frame, in words a stranger could point at."
              },
              "framing_fill": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Subject extent / frame shorter side (or state width fraction in composition)."
              },
              "composition": {
                "type": "string",
                "description": "Placement: centred, left third, right-end crop, off-centre by x%, rotated n°."
              },
              "movement_class": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "camera",
                    "object",
                    "content",
                    "none"
                  ]
                }
              },
              "hold_carrier": {
                "type": "string",
                "description": "What keeps the frame alive while it holds (typing, cursor, settle, streaming text, colour cycle, haze drift, nothing)."
              },
              "repeats": {
                "type": "string",
                "description": "Id of the earlier scene this one repeats frame-for-frame (a looped or two-cycle film). The row is still written in full; a builder may keep one cycle on purpose."
              },
              "note": {
                "type": "string"
              },
              "evidence": {
                "$ref": "#/definitions/evidence"
              },
              "confidence": {
                "$ref": "#/definitions/confidence"
              }
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "required": [
        "cadence_landings_per_s",
        "lens_moves",
        "max_hold",
        "ease_voice",
        "zoom_range",
        "landings",
        "lens_note"
      ],
      "properties": {
        "cadence_landings_per_s": {
          "type": "number",
          "description": "Landings ÷ duration, counting EVERY landing: the opening frame at t = 0, every cut, every travelled move, and every repeated cycle's landings (the ledger is literal). How often the frame lands somewhere new."
        },
        "lens_moves": {
          "type": "integer",
          "minimum": 0,
          "description": "How many landings are TRAVELLED (move_in other than cut / hold). 0 = fixed lens: every framing change is a cut and lens_note says what carries the film instead."
        },
        "max_hold": {
          "type": "number",
          "description": "Longest a single framing stands, seconds."
        },
        "ease_voice": {
          "type": "string",
          "description": "Film default for camera moves: cut | snap | glide | anticipate | punch | fixed. Per-landing overrides live in the rows."
        },
        "zoom_range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "lens_note": {
          "type": "string",
          "description": "One sentence: does the lens move at all (how many times, which kind), and what moves instead (object / content)."
        },
        "landings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t",
              "subject",
              "fill",
              "move_in",
              "duration",
              "hold",
              "movement_class",
              "evidence"
            ],
            "properties": {
              "t": {
                "type": "number"
              },
              "subject": {
                "type": "string"
              },
              "fill": {
                "type": "number",
                "description": "Subject height ÷ frame height (or width fraction; say which in fill_basis)."
              },
              "fill_basis": {
                "type": "string",
                "enum": [
                  "height",
                  "width",
                  "shorter-side",
                  "zoom"
                ],
                "default": "height"
              },
              "zoom": {
                "type": "number",
                "description": "Derived stage zoom relative to the widest framing (1.0 = whole composition)."
              },
              "move_in": {
                "type": "string",
                "enum": [
                  "cut",
                  "snap",
                  "glide",
                  "push",
                  "pull",
                  "whip",
                  "blur push",
                  "anticipate",
                  "drift",
                  "hold",
                  "track",
                  "punch"
                ],
                "description": "cut = the framing changes between two frames (the seam ledger names the join). track = a continuous follow: one landing with duration = its length and hold 0. blur push = the lens pushes into the surface already on screen under blur (the seam of the same name)."
              },
              "duration": {
                "type": "number",
                "description": "Seconds the move takes (0 for cut)."
              },
              "hold": {
                "type": "number",
                "description": "Seconds the framing stands: next landing's t minus (this t + duration). A travelled move is not counted twice."
              },
              "twin_of": {
                "type": "string",
                "description": "t of the earlier landing this one repeats frame-for-frame (a looped film). The row is still written; its evidence may say 'twin' and cite the twin's tiles."
              },
              "movement_class": {
                "type": "string",
                "enum": [
                  "camera",
                  "object",
                  "content"
                ],
                "description": "camera = whole composition reframes (every landing reached by a cut is camera: the framing changed even though nothing travelled); object = one element changes; content = things change inside a stable surface. A card growing is NOT a camera move."
              },
              "ease": {
                "$ref": "#/definitions/ease_ref"
              },
              "onset_delta_ms": {
                "type": "number",
                "description": "Signed ms from the landing to the nearest audio onset, when audio exists. A value inside ±100 ms with on_onset false is a near miss worth reading."
              },
              "box": {
                "type": "object",
                "description": "Optional. The subject's box in source-frame px (x, y, w, h measured on frame.mjs output); the After Effects brief derives the rig's anchor point from its centre and says 'measure' when it is absent.",
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  }
                }
              },
              "rotation_deg": {
                "type": "number",
                "description": "Optional. Rotation of the framing in degrees at this landing (a yawed or tilted three-quarter view); absent or 0 = frontal."
              },
              "trigger": {
                "type": "object",
                "description": "Optional. What fires this landing's move: a cursor press (kind 'press', with its t / frame_24), a music beat ('beat'), or nothing ('none'); the AE brief prints the press frame per landing.",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "press",
                      "beat",
                      "none"
                    ]
                  },
                  "t": {
                    "type": "number",
                    "description": "Seconds of the press or beat."
                  },
                  "frame_24": {
                    "type": "integer",
                    "description": "The 24 fps badge frame of the press or beat (1-based, as printed on the sheets)."
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              "note": {
                "type": "string",
                "description": "Frame-by-frame measurements that justify the verb (positions per tile, scale ratios). Rendered in the briefs."
              },
              "evidence": {
                "$ref": "#/definitions/evidence"
              },
              "confidence": {
                "$ref": "#/definitions/confidence"
              }
            }
          }
        }
      }
    },
    "seams": {
      "type": "array",
      "description": "The seam ledger, from cuts.json. One row per transition between compositions.",
      "items": {
        "$ref": "#/definitions/seam"
      }
    },
    "pacing": {
      "type": "object",
      "required": [
        "landing_cadence_per_s",
        "holds",
        "longest_hold",
        "cuts_per_10s",
        "seams_on_onsets",
        "typing_cadence",
        "stagger_spacing"
      ],
      "properties": {
        "landing_cadence_per_s": {
          "type": "number"
        },
        "holds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t",
              "duration",
              "carrier"
            ],
            "properties": {
              "t": {
                "type": "number"
              },
              "duration": {
                "type": "number"
              },
              "carrier": {
                "type": "string"
              }
            }
          }
        },
        "longest_hold": {
          "type": "number"
        },
        "cuts_per_10s": {
          "type": "number"
        },
        "seams_on_onsets": {
          "type": "string",
          "description": "\"5 of 7 seams within 60 ms of an audio onset (chance level ~2 of 7 at this onset rate)\" or \"0 of 13 — the bed is flat, nothing lines up\" or \"no audio\". Use audio.json onset_rate_per_s × 0.12 s × seams for the chance level."
        },
        "typing_cadence": {
          "type": "string",
          "description": "chars/s and burst shape, or \"no typing\"."
        },
        "stagger_spacing": {
          "type": "string",
          "description": "Seconds between sibling entrances, or \"none\"."
        }
      }
    },
    "ui_motion": {
      "type": "object",
      "required": [
        "cursor_present",
        "clicks",
        "typing_beats",
        "payoffs",
        "agent_vs_user"
      ],
      "properties": {
        "cursor_present": {
          "type": "boolean"
        },
        "cursor_style": {
          "type": "string",
          "description": "arrow / hand / dot; size as fraction of frame height; approach path shape (straight axis, arc)."
        },
        "clicks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t",
              "target",
              "reaction"
            ],
            "properties": {
              "t": {
                "type": "number"
              },
              "target": {
                "type": "string"
              },
              "reaction": {
                "type": "string",
                "description": "press state (colour, scale), ripple, none."
              },
              "pre_pause": {
                "type": "number",
                "description": "Seconds the cursor rests on the target before the state changes."
              },
              "evidence": {
                "$ref": "#/definitions/evidence"
              }
            }
          }
        },
        "hover_states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "typing_beats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "in",
              "out",
              "text_role",
              "cadence"
            ],
            "properties": {
              "in": {
                "type": "number"
              },
              "out": {
                "type": "number"
              },
              "text_role": {
                "type": "string"
              },
              "cadence": {
                "type": "string",
                "description": "chars/s; steady / bursts; caret visible?"
              },
              "per_char_timing": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "description": "Absolute seconds each character appears, when the f-sheets give them."
              },
              "surface_growth": {
                "type": "string",
                "description": "Does the input grow while typing (factor, over how long)?"
              },
              "evidence": {
                "$ref": "#/definitions/evidence"
              }
            }
          }
        },
        "dropdowns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "t": {
                "type": "number"
              },
              "drop_distance_frac": {
                "type": "number"
              },
              "duration": {
                "type": "number"
              },
              "evidence": {
                "$ref": "#/definitions/evidence"
              }
            }
          }
        },
        "card_rises": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "t": {
                "type": "number"
              },
              "rise_distance_frac": {
                "type": "number"
              },
              "from_scale": {
                "type": "number"
              },
              "soft_in": {
                "type": "boolean"
              },
              "duration": {
                "type": "number"
              },
              "evidence": {
                "$ref": "#/definitions/evidence"
              }
            }
          }
        },
        "payoffs": {
          "type": "array",
          "description": "Each result / completion moment: what changes, how it is emphasised, how long the 'before' is shown.",
          "items": {
            "type": "object",
            "required": [
              "t",
              "what",
              "emphasis",
              "before_hold"
            ],
            "properties": {
              "t": {
                "type": "number"
              },
              "what": {
                "type": "string"
              },
              "emphasis": {
                "type": "string",
                "description": "wash, pulse, tick fill, colour swap, none."
              },
              "before_hold": {
                "type": "number",
                "description": "Seconds the pre-state is visible before the change."
              },
              "evidence": {
                "$ref": "#/definitions/evidence"
              }
            }
          }
        },
        "agent_vs_user": {
          "type": "string",
          "description": "Which steps are performed with a cursor (user) and which appear on their own (agent / system)."
        }
      }
    },
    "text_motion": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t",
          "text_role",
          "mechanism",
          "hold",
          "evidence"
        ],
        "properties": {
          "t": {
            "type": "number"
          },
          "text_role": {
            "type": "string"
          },
          "mechanism": {
            "type": "string",
            "enum": [
              "word pop",
              "letter mask",
              "blur resolve",
              "type-on",
              "selection sweep",
              "slide",
              "fade",
              "gradient sweep trail",
              "count-up",
              "word roll",
              "scale settle",
              "cut-in",
              "glitch",
              "other"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "entrance",
              "exit",
              "swap"
            ],
            "description": "Whether the mechanism brings the text in, takes it out, or replaces it in place. Default entrance."
          },
          "per_word_timing": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Absolute seconds each word/line lands, when discrete."
          },
          "per_char_timing": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Absolute seconds each character appears (type-on), when the strip gives them."
          },
          "twin_of": {
            "type": "string",
            "description": "t of the earlier text beat this one repeats frame-for-frame."
          },
          "duration": {
            "type": "number"
          },
          "hold": {
            "type": "number"
          },
          "ease": {
            "$ref": "#/definitions/ease_ref"
          },
          "onset_delta_ms": {
            "type": "number"
          },
          "note": {
            "type": "string",
            "description": "Per-character timings, cadence measurements, anything the mechanism name does not carry. Rendered in the briefs."
          },
          "evidence": {
            "$ref": "#/definitions/evidence"
          },
          "confidence": {
            "$ref": "#/definitions/confidence"
          }
        }
      }
    },
    "grammar": {
      "type": "object",
      "required": [
        "entrances",
        "exits",
        "reveal_order",
        "motifs"
      ],
      "properties": {
        "entrances": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reveal_order": {
          "type": "string"
        },
        "motifs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sound": {
      "type": "object",
      "required": [
        "present",
        "measured",
        "layers",
        "energy_arc",
        "sync_points",
        "silence",
        "ending"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "measured": {
          "type": "object",
          "properties": {
            "integrated_lufs": {
              "type": [
                "number",
                "null"
              ]
            },
            "lra_lu": {
              "type": [
                "number",
                "null"
              ]
            },
            "true_peak_dbtp": {
              "type": [
                "number",
                "null"
              ]
            },
            "note": {
              "type": "string",
              "default": "Mixed program measurement. Not a delivery target. Stems, ducking and SFX counts cannot be recovered."
            }
          }
        },
        "layers": {
          "type": "object",
          "properties": {
            "vo": {
              "type": "string"
            },
            "music": {
              "type": "string"
            },
            "sfx": {
              "type": "string"
            }
          }
        },
        "energy_arc": {
          "type": "string",
          "description": "From rms_dbfs_by_decile: flat / rising / dip at N / drop at the end."
        },
        "sync_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "t": {
                "type": "number"
              },
              "visual": {
                "type": "string"
              },
              "audio": {
                "type": "string"
              }
            }
          }
        },
        "silence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              }
            }
          }
        },
        "ending": {
          "type": "string",
          "description": "hard stop / fade / sting / silence before end."
        }
      }
    },
    "eases": {
      "type": "array",
      "description": "Every ease used anywhere in the spec, so AE / Remotion / CSS can map it.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "gsap",
          "cubic_bezier",
          "frames_24",
          "used_for"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "gsap": {
            "type": "string"
          },
          "cubic_bezier": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "frames_24": {
            "type": "integer",
            "description": "Typical duration in frames at 24 fps."
          },
          "used_for": {
            "type": "string"
          },
          "confidence": {
            "$ref": "#/definitions/confidence"
          }
        }
      }
    },
    "do_not": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mistakes that would change the style."
    },
    "evidence_rules": {
      "type": "string",
      "default": "Every seam and landing cites sheet + tile(s). A row with evidence:[] is a guess, carries confidence:\"low\", and is flagged by validate-spec.mjs. Sheet ids: c-NNN (4 fps composition, tiles 1-30), f-NNN (24 fps full, tiles 1-48), w-<t> (24 fps strip, tiles 1-N per windows/index.json), overview (cells 1-24). Tile numbers are per sheet: tile = badge frame - 30 x (sheet - 1) on c-sheets, - 48 x (sheet - 1) on f-sheets; map.txt resolves any cell. note fields are allowed on every row and are rendered in the briefs."
    }
  },
  "definitions": {
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "evidence": {
      "type": "array",
      "description": "Citations. Each: sheet id + tile numbers (1-based, row-major) + optional note.",
      "items": {
        "type": "object",
        "required": [
          "sheet",
          "tiles"
        ],
        "properties": {
          "sheet": {
            "type": "string",
            "description": "c-001 | f-003 | w-4.42 | overview | frame-3.00 (a frames/frame-<t>.png measurement frame: tiles may be empty; the badge's frame number is the same frame on the f-sheets)"
          },
          "tiles": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "ease_ref": {
      "type": "object",
      "required": [
        "gsap",
        "cubic_bezier"
      ],
      "properties": {
        "gsap": {
          "type": "string"
        },
        "cubic_bezier": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "basis": {
          "type": "string",
          "enum": [
            "read from strip",
            "vocabulary default",
            "guess"
          ],
          "default": "vocabulary default"
        }
      }
    },
    "seam": {
      "type": "object",
      "required": [
        "t",
        "kind",
        "frames_24",
        "duration",
        "outgoing",
        "incoming",
        "carrier",
        "on_onset",
        "ease",
        "evidence",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "t": {
          "type": "number",
          "description": "Seconds where the seam STARTS: the first frame that differs from the outgoing hold (usually before the cut). The cut — the next scene's `in` — sits inside [t, t_end]. Read it from the 24 fps strip, never from the scene boundary."
        },
        "t_end": {
          "type": "number",
          "description": "t + frames_24 / 24: where the seam ends (the incoming is settled). The validator warns when it disagrees with frames_24."
        },
        "twin_of": {
          "type": "string",
          "description": "id of the earlier seam this one repeats frame-for-frame (a looped film). Still written in full; evidence may cite the twin's strip."
        },
        "kind": {
          "type": "string",
          "description": "One name from references/vocabulary.md § Seams. Directional kinds (throw, whip, wipe, slide, colour sweep) carry their direction in outgoing.direction / incoming.direction; 'leftward throw' is kept as an alias of throw + direction left.",
          "enum": [
            "hard cut",
            "match cut",
            "reframe cut",
            "pixel-matched hard cut",
            "crossfade",
            "position-locked crossfade",
            "blur-dissolve",
            "soft-to-sharp resolve",
            "melt + settle-in",
            "blur push",
            "dip-to-colour",
            "colour sweep",
            "wipe",
            "whip",
            "zoom-through",
            "inverse zoom-through",
            "corner swell",
            "leftward throw",
            "throw",
            "Flip morph",
            "slide",
            "push-through",
            "mask reveal",
            "glitch cut",
            "clear-then-resolve",
            "travel",
            "other"
          ]
        },
        "opens_film": {
          "type": "boolean",
          "description": "true when the film starts inside this transition (t = 0, no outgoing composition): the pre-roll rule."
        },
        "loop_join": {
          "type": "boolean",
          "description": "true when this seam joins the end of one cycle to the start of the next (a looped film)."
        },
        "frames_24": {
          "type": "integer",
          "description": "Frames the seam spans at 24 fps (1 = true hard cut)."
        },
        "duration": {
          "type": "number"
        },
        "from_scene": {
          "type": "string"
        },
        "to_scene": {
          "type": "string"
        },
        "outgoing": {
          "type": "object",
          "required": [
            "treatment"
          ],
          "properties": {
            "treatment": {
              "type": "string",
              "pattern": "^(none|blur|dim|slide|scale-down|scale-up|covered|fade|spin)(\\+(blur|dim|slide|scale-down|scale-up|covered|fade|spin))*$",
              "description": "Tokens joined with '+': 'blur+dim', 'slide+blur', 'scale-down+blur+dim' (the melt shape). Tokens: none, blur, dim, slide, scale-down, scale-up, covered, fade, spin."
            },
            "direction": {
              "type": "string",
              "enum": [
                "left",
                "right",
                "up",
                "down",
                "up-left",
                "up-right",
                "down-left",
                "down-right",
                "in",
                "out",
                "none"
              ]
            },
            "amount": {
              "type": "string",
              "description": "e.g. 'blur to unreadable over 3 frames', 'x -13% of width', 'scale 1.0 -> 0.8'."
            },
            "frames_24": {
              "type": "integer"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "incoming": {
          "type": "object",
          "required": [
            "treatment"
          ],
          "properties": {
            "treatment": {
              "type": "string",
              "pattern": "^(none|soft-then-sharp|slide-in|settle-from-large|settle-from-small|pop|fade-in|reveal-behind|already-moving|spin-in)(\\+(soft-then-sharp|slide-in|settle-from-large|settle-from-small|fade-in|already-moving|spin-in))*$",
              "description": "Tokens joined with '+': 'slide-in+soft-then-sharp', 'settle-from-large+soft-then-sharp'. Tokens: none, soft-then-sharp, slide-in, settle-from-large, settle-from-small, pop, fade-in, reveal-behind, already-moving, spin-in."
            },
            "direction": {
              "type": "string",
              "enum": [
                "left",
                "right",
                "up",
                "down",
                "up-left",
                "up-right",
                "down-left",
                "down-right",
                "in",
                "out",
                "none"
              ]
            },
            "from_scale": {
              "type": "number"
            },
            "frames_24": {
              "type": "integer"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "overlap_frames": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional. How many frames (24 fps) both compositions are visible at once; 0 for a cut. When absent the AE brief derives it: 0 for a hard / match / reframe / pixel-matched cut, else frames_24."
        },
        "blur_px_1080": {
          "type": "number",
          "minimum": 0,
          "description": "Optional. Peak blur radius in px at 1080p when a side blurs (outgoing blur, incoming soft-then-sharp); the AE brief scales it by comp height ÷ 1080 and falls back to the vocabulary default (≈20 px) when absent."
        },
        "dim_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Optional. How far the dimming side dims, 0–100 (100 = fully to the bed); the AE brief renders it as the Opacity target (100 − dim_pct) and says 'none' when no side dims."
        },
        "settle_on_onset": {
          "type": "boolean",
          "description": "The incoming's settle frame (B) lands within ±60 ms of an audio onset — often the musically meaningful sync when the seam start does not."
        },
        "carrier": {
          "type": "string",
          "description": "What stays continuous across the seam: an element, a colour, a baseline, a corner mark, a cursor, the music. 'none' for a true hard cut with no shared element."
        },
        "on_onset": {
          "type": "boolean",
          "description": "Within ±60 ms of an audio onset from audio.json."
        },
        "onset_delta_ms": {
          "type": "number"
        },
        "ease": {
          "$ref": "#/definitions/ease_ref"
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
