{
  "targetPath": "/wp-admin/admin.php?page=wpforms-builder&view=settings&form_id=1725",
  "variants": [
    {
      "slug": "builder-settings-entry_automation-gdrive-signin",
      "waitFor": "#wpforms-google-drive-sign-in",
      "steps": [
        {
          "click": ".wpforms-panel-sidebar-section-entry_automation",
          "settle": 1200
        },
        {
          "eval": "document.querySelector('#wpforms-entry-automation-dashboard-notice .wpforms-dismiss-button')?.click()",
          "settle": 600
        },
        {
          "click": ".wpforms-builder-entity-connection-add",
          "settle": 1200
        },
        {
          "eval": "document.querySelector('#wpforms-builder-entity-connection-name').value = 'Weekly Catering Export'",
          "settle": 400
        },
        {
          "click": ".jconfirm .btn-confirm",
          "settle": 3000
        },
        {
          "eval": "document.querySelector('.wpforms-entry-automation-task-type input[id$=\"-export\"]').click()",
          "settle": 3000
        },
        {
          "eval": "var s = document.querySelector('.wpforms-entry-automation-export-to'); s.value = 'google'; jQuery(s).trigger('change');",
          "settle": 3500
        }
      ]
    }
  ]
}