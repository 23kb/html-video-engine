{
  "_comment": "Smart Tags long-form tutorial (form 1924 'Sullie's Bakery Catering Request', page /catering-request/). WPForms 2.0.2 refresh of the smart-tag widget surfaces + the two payoff surfaces that need a real server round-trip. Existing builder-settings-notifications / builder-field-options-* snapshots are April 2026 pre-2.0 and are NOT overwritten.",
  "targetPath": "/wp-admin/admin.php?page=wpforms-builder&form_id=1924&view=settings",
  "variants": [
    {
      "slug": "frontend-catering-prefilled",
      "targetPath": "/catering-request/",
      "steps": [
        {
          "wait": 2500
        },
        {
          "eval": "['header','nav','.site-header','#masthead','.main-navigation','#site-navigation','form[role=\"search\"]','.search-form','#secondary','.widget-area','aside','footer','.site-footer','#colophon','#wpadminbar','.post-edit-link','.wpforms-form-edit-link'].forEach(function(s){document.querySelectorAll(s).forEach(function(n){n.remove();});});document.body.style.margin='0';",
          "settle": 400
        },
        {
          "eval": "var e=document.querySelector('#wpforms-1924-field_2'); if(!e||!e.value){ throw new Error('email not prefilled by {user_email} \u2014 check logged-in state'); }",
          "settle": 300
        }
      ],
      "waitFor": ".wpforms-form"
    },
    {
      "slug": "frontend-catering-confirmed",
      "targetPath": "/",
      "steps": [
        {
          "wait": 2000
        },
        {
          "eval": "window.location.href='/catering-request/';",
          "settle": 4500
        },
        {
          "eval": "['header','nav','.site-header','#masthead','.main-navigation','#site-navigation','form[role=\"search\"]','.search-form','#secondary','.widget-area','aside','footer','.site-footer','#colophon','#wpadminbar','.post-edit-link','.wpforms-form-edit-link'].forEach(function(s){document.querySelectorAll(s).forEach(function(n){n.remove();});});document.body.style.margin='0';",
          "settle": 400
        },
        {
          "eval": "var t=document.querySelector('#wpforms-1924-field_3'); if(!t){ throw new Error('message textarea missing'); } t.value='Two dozen sourdough loaves and a birthday cake for Saturday the 14th.'; t.dispatchEvent(new Event('input',{bubbles:true}));",
          "settle": 600
        },
        {
          "click": "#wpforms-submit-1924",
          "settle": 6000
        },
        {
          "eval": "['header','nav','.site-header','#masthead','.main-navigation','#site-navigation','form[role=\"search\"]','.search-form','#secondary','.widget-area','aside','footer','.site-footer','#colophon','#wpadminbar','.post-edit-link','.wpforms-form-edit-link'].forEach(function(s){document.querySelectorAll(s).forEach(function(n){n.remove();});});document.body.style.margin='0';",
          "settle": 400
        },
        {
          "eval": "var c=document.querySelector('.wpforms-confirmation-container-full'); if(!c){ throw new Error('no confirmation container \u2014 submit failed'); }",
          "settle": 300
        }
      ],
      "waitFor": ".wpforms-confirmation-container-full"
    }
  ]
}