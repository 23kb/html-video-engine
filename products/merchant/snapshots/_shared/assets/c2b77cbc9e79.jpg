<link rel='stylesheet' id='botiga-style-min-css' href='http://fernhillhome.com/wp-content/themes/botiga/assets/css/styles.min.css?ver=2.4.7' media='all' />
<link rel='stylesheet' id='botiga-custom-styles-css' href='http://fernhillhome.com/wp-content/uploads/botiga/custom-styles.css?ver=1790955174' media='all' />
<link rel='stylesheet' id='botiga-style-css' href='http://fernhillhome.com/wp-content/themes/botiga/style.css?ver=2.4.7' media='all' />
<style id="botiga-style-inline-css">

            #botiga-admin-tb-top-bar {
                white-space: nowrap;
            }

            #botiga-admin-tb-top-bar a {
                height: 27px !important;
            }

            #botiga-admin-tb-top-bar .template-name {
                white-space: nowrap;
                text-overflow: ellipsis;
                overflow: hidden;
                width: 100%;
            }

            #botiga-admin-tb-top-bar .template-location {
                display: block;
                background-color: #414141;
                color: rgba(240, 246, 252, .7);
                padding: 4px 6px;
                font-sizeL 0.9em;
                line-height: 1;
                border-radius: 3px;
                text-align: center;
            }

            #botiga-admin-tb-top-bar-sub {
                width: 220px;
            }

            #botiga-admin-tb-top-bar-sub a {
                display: flex !important;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
            }
            
            #wpadminbar #botiga-admin-tb-top-bar-add-new {
                border-block-start: 1px solid #464b50;
                margin-block-start: 6px;
            }
        

            .bt-hook-wrapper {
                display: block;
                position: relative;
                width: 100%;
                background-color: rgba(0, 0, 0, 0.05);
                border: 1px dashed rgba(0, 0, 0, 0.4);
                padding: 10px;
                margin: 15px 0;
                border-radius: 5px;
                text-align: left;
            }

            .bt-hook-wrapper .bt-hook-id {
                display: block;
                font-size: 12px;
                color: rgba(0, 0, 0, 0.5);
            }

            .bt-hook-wrapper .bt-hook-edit {
                position: absolute;
                top: 9px;
                right: 9px;
                line-height: 1;
                opacity: 0.5;
                transition: ease opacity 250ms;
            }

            .bt-hook-wrapper .bt-hook-edit:hover {
                opacity: 1;
            }

            .bt-hook-wrapper .bt-hook-edit svg {
                width: 20px;
                height: auto;
                fill: #212121 !important;
            }

            .bt-hook-wrapper[data-hook-id="botiga_hook_woocommerce_after_main_content"] {
                margin: 15px 15px;
            }

            .bt-hook-wrapper.has-content {
                border-color: #212121;
            }

            .woocommerce-page-header + .bt-hook-wrapper {
                margin-top: 60px;
            }

            .single-product .site-main>.product>section.products:last-child {
                margin-bottom: 0;
            } 
        
/*# sourceURL=botiga-style-inline-css */
</style>
<script type="text/template" id="tmpl-variation-template">
